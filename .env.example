# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git НЕ попадает (см. .gitignore).

# --- Приложение ---
APP_NAME="AdGen AI"
DEBUG=true
# Секрет для подписи cookie/JWT (понадобится в Спринте 3).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# --- PostgreSQL ---
# Эти же переменные читает контейнер postgres при первом запуске
POSTGRES_USER=adgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adgen
# Внутри docker-compose база доступна по имени сервиса "db"
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (брокер и хранилище результатов Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Файлы ---
MEDIA_DIR=media
# Максимальный размер загружаемого фото, МБ
MAX_UPLOAD_MB=10

# --- Удаление фона (rembg) ---
REMBG_MODEL=isnet-general-use

# --- Генерация фона нейросетью (Спринт 2) ---
# Провайдер: huggingface (по умолчанию). Токен: https://huggingface.co/settings/tokens
IMAGE_PROVIDER=huggingface
HF_API_TOKEN=
