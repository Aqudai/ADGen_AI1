# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git НЕ попадает (см. .gitignore).

# --- Приложение ---
APP_NAME="AdGen AI"
DEBUG=true
# Секрет для подписи cookie/JWT (понадобится в Спринте 3).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# --- PostgreSQL ---
# Эти же переменные читает контейнер postgres при первом запуске
POSTGRES_USER=adgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adgen
# Внутри docker-compose база доступна по имени сервиса "db"
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (брокер и хранилище результатов Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Файлы ---
MEDIA_DIR=media
# Максимальный размер загружаемого фото, МБ
MAX_UPLOAD_MB=10

# --- Удаление фона (rembg) ---
REMBG_MODEL=isnet-general-use

# --- Генерация сцены нейросетью ---
# huggingface — нейросеть через Hugging Face; fallback — всегда рисовать запасной фон без нейросети
IMAGE_PROVIDER=huggingface
# Ключ: https://huggingface.co/settings/tokens → Create new token → Fine-grained →
# галочка «Make calls to Inference Providers». Без ключа или без кредитов на аккаунте
# сервис нарисует запасной фон и напишет причину на странице результата.
HF_TOKEN=
# Модель и провайдер. По умолчанию FLUX.1-schnell через nscale (~$0.0014 за картинку).
# Вариант со Stable Diffusion 3: HF_PROVIDER=hf-inference и
# HF_MODEL=stabilityai/stable-diffusion-3-medium-diffusers (сначала примите лицензию на странице модели).
HF_PROVIDER=nscale
HF_MODEL=black-forest-labs/FLUX.1-schnell
